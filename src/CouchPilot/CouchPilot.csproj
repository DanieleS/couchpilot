<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <AssemblyName>CouchPilot</AssemblyName>
    <RootNamespace>CouchPilot</RootNamespace>
    <Version>0.6.1</Version>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Playnite ships its own Playnite.SDK.dll: compile against it, never copy it. -->
    <PackageReference Include="PlayniteSDK" Version="6.18.0" ExcludeAssets="runtime" />
    <PackageReference Include="EmbedIO" Version="3.5.2" />
    <PackageReference Include="MQTTnet" Version="4.3.7.1207" />
    <!-- WinRT from .NET Framework: the media controls Windows shows on its volume flyout. -->
    <PackageReference Include="Microsoft.Windows.SDK.Contracts" Version="10.0.22621.2428" />
    <!-- Lets the project build on machines without the .NET Framework targeting pack. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <!-- DPAPI (ProtectedData) for the sealed unlock password; SystemEvents lives in System. -->
    <Reference Include="System.Security" />
    <!-- Sends deleted captures to the Recycle Bin. -->
    <Reference Include="Microsoft.VisualBasic" />
    <Reference Include="System.Drawing" />
    <!-- Lets C# await WinRT async operations. -->
    <Reference Include="System.Runtime.WindowsRuntime" />
    <Reference Include="System.Xaml" />
    <Reference Include="WindowsBase" />
  </ItemGroup>

  <ItemGroup>
    <None Include="extension.yaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="icon.png" CopyToOutputDirectory="PreserveNewest" Condition="Exists('icon.png')" />
    <!-- The gallery's video thumbnails: built by scripts/build-ffmpeg.sh, absent from a plain
         checkout, where clips fall back to Windows' own thumbnails. -->
    <None Include="ffmpeg\ffmpeg.exe" Link="ffmpeg.exe" CopyToOutputDirectory="PreserveNewest" Condition="Exists('ffmpeg\ffmpeg.exe')" />
    <None Include="ffmpeg\ffmpeg-readme.txt" Link="ffmpeg-readme.txt" CopyToOutputDirectory="PreserveNewest" Condition="Exists('ffmpeg\ffmpeg-readme.txt')" />
    <!-- The lock-screen unlock: the credential provider and its elevated setup helper, built by
         CMake/MSVC in the build workflow. Absent from a plain checkout, where unlocking reports
         itself unavailable, like the gallery without ffmpeg. -->
    <None Include="native\CouchPilotUnlock.dll" Link="CouchPilotUnlock.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('native\CouchPilotUnlock.dll')" />
    <None Include="native\CouchPilotUnlockSetup.exe" Link="CouchPilotUnlockSetup.exe" CopyToOutputDirectory="PreserveNewest" Condition="Exists('native\CouchPilotUnlockSetup.exe')" />
    <!-- The PWA, built by `pnpm build` in /web. -->
    <None Include="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
